<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer glowing cyber halo representing viral amplification -->
    <path
        android:pathData="M 54,34 A 20,20 0 1,1 53.9,34 Z"
        android:strokeWidth="3"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="34"
                android:endX="74"
                android:endY="74"
                android:type="linear">
                <item android:color="#F43F5E" android:offset="0.0" />
                <item android:color="#8B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Custom Sharp Viral V logo with high perspective energy -->
    <path
        android:pathData="M 40,38 L 54,68 L 68,38 L 59,38 L 54,52 L 49,38 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="38"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:color="#8B5CF6" android:offset="0.0" />
                <item android:color="#F43F5E" android:offset="0.7" />
                <item android:color="#06B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon center lightning spark crossing the V shape -->
    <path
        android:pathData="M 57,30 L 46,50 L 53,50 L 51,64 L 62,44 L 55,44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="30"
                android:endX="62"
                android:endY="64"
                android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
